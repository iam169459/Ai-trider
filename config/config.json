{
    "$schema": "https://schema.freqtrade.io/schema.json",

    "max_open_trades": 1,
    "stake_currency": "USDT",
    "stake_amount": 20,
    "tradable_balance_ratio": 0.99,
    "available_capital": 50,

    "dry_run": true,
    "dry_run_wallet": 50,
    "trading_mode": "spot",
    "timeframe": "1h",
    "strategy": "ConservativeTrendStrategy",
    "initial_state": "running",
    "cancel_open_orders_on_exit": true,
    "bot_name": "ai-trider-conservative",

    "fee": 0.001,

    "minimal_roi": {
        "0": 0.04,
        "48": 0.06,
        "96": 0.08,
        "168": 0.10
    },
    "stoploss": -0.04,
    "trailing_stop": false,
    "trailing_stop_positive": 0.01,
    "trailing_stop_positive_offset": 0.03,
    "trailing_only_offset_is_reached": true,
    "use_exit_signal": true,
    "exit_profit_only": false,
    "ignore_roi_if_entry_signal": false,

    "unfilledtimeout": {
        "entry": 10,
        "exit": 5,
        "unit": "minutes",
        "exit_timeout_count": 3
    },

    "order_types": {
        "entry": "limit",
        "exit": "limit",
        "emergency_exit": "market",
        "force_entry": "limit",
        "stoploss": "market",
        "stoploss_on_exchange": true,
        "stoploss_price_type": "last"
    },
    "order_time_in_force": {
        "entry": "GTC",
        "exit": "GTC"
    },

    "entry_pricing": {
        "price_side": "same",
        "use_order_book": true,
        "order_book_top": 1,
        "price_last_balance": 0.0,
        "check_depth_of_market": {
            "enabled": false,
            "bids_to_ask_delta": 0
        }
    },
    "exit_pricing": {
        "price_side": "same",
        "use_order_book": true,
        "order_book_top": 1,
        "price_last_balance": 0.0
    },

    "exchange": {
        "name": "binance",
        "ccxt_config": {
            "enableRateLimit": true
        },
        "ccxt_async_config": {
            "enableRateLimit": true,
            "rateLimit": 200
        },
        "pair_whitelist": [
            "BTC/USDT",
            "ETH/USDT"
        ],
        "pair_blacklist": []
    },

    "pairlists": [
        {
            "method": "StaticPairList"
        }
    ],

    "api_server": {
        "enabled": true,
        "listen_ip_address": "127.0.0.1",
        "listen_port": 8080,
        "verbosity": "error",
        "CORS_origins": []
    },

    "db_url": "sqlite:///user_data/tradesv3.dryrun.sqlite",
    "logfile": "user_data/logs/freqtrade.log",

    "internals": {
        "process_throttle_secs": 5,
        "heartbeat_interval": 60
    },

    "add_config_files": [
        "secrets.json"
    ]
}
